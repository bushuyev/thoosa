package "test_types (cfg(test))" {
  class TestId {
    -0: &'static str
  }
  class TestInput {
    +id: TestId
    +data: DummyTensor
    {static} +new(n: u32): Self
  }
  class TestOutput {
    +id: TestId
    +v: TestData
    {static} +new(v: f32): Self
  }
  class TestData {
    +0: f32
  }
}
package "tests (cfg(test))" {
  class AsyncTestStage <<private>> {
    -results: Arc<Mutex<VecDeque<Result<TestOutput, ThoError>>>>
    {static} -new(results): Self
    {field} +type In<'a> = Arc<DevicesWrap<TestInput>>
    {field} +type Out = Arc<DevicesWrap<TestOutput>>
    {field} +type Ctx = MockRunCtx
  }
  class AsyncInputCtx <<private>> {
    -outputs: Vec<Arc<DevicesWrap<TestOutput>>>
  }
  class BorrowOnlyInput <<private>> {
    -inner: TestInput
    {static} -new(inner: TestInput): Self
    {field} +type Out<'a> = &'a TestInput
  }
}
package "Mocks declared in oom_handler.rs" {
  class InputContextBuilder {
    -mock: MockInputContext
    +with_partial_output(inp: TestOutput): Self
    +with_build_final_output(inp: TestOutput): Self
    +with_all_done(out: &[bool]): Self
    +finish(): MockInputContext
  }
  class MockInputContext <<mockall>>
  class MockRunnableContext <<automock>>
  class MockRunCtxContext <<automock>>
  class MockRunnable <<mockall>> {
    {field} +type In<'a> = TestInput
    {field} +type Out = TestOutput
    {field} +type Ctx = MockRunCtx
  }
  class MockInputAdjuster <<mockall>> {
    {field} +type A = RangeSelector
  }
  class MockStageAdjuster <<mockall>> {
    {field} +type A = Arc<MockRunnable>
  }
  class MockContextAdjuster <<mockall>> {
    {field} +type A = MockRunCtx
  }
}
