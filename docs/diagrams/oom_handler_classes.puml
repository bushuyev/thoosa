' Document the static relationships separately from oom_handler.puml's retry flow.
' Source: crates/thoosa_common/src/runner/oom_handler.rs
' Syntax: https://plantuml.com/class-diagram
' Two views keep test scaffolding from obscuring the production types.
@startuml oom_handler_classes
title OOM handler: production traits and structs
left to right direction
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

legend bottom left
  Interfaces represent Rust traits; classes represent Rust structs.
  <<external>> types are defined outside oom_handler.rs.
  <<impl target>> boxes denote existing Rust trait-object types, not new structs.
  Dashed triangles represent trait implementations; dotted arrows represent dependencies.
  Method signatures omit self and routine bounds; async methods are marked explicitly.
  Context and adjustment bounds are shown on relationships and in notes.
endlegend

package "Adjustment dispatch" {
  interface "Adjuster<AC>" as Adjuster {
    {field} +type A: Adjustable
    +async adjust(adjustable: A, adjust_context: &mut AC): Result<A, AdjusterError<A>>
    +degrade(adjust_context: &mut AC): bool
  }
  enum "AdjusterError<A: Adjustable>" as AdjusterError {
    AdjustFailed(A)
    SomethingElse(ThoError)
  }
  enum "Adjusters<IA = NoInputAdjuster, SA = NoStageAdjuster, CA = NoRunCtxAdjuster>" as Adjusters {
    Input(IA)
    Stage(SA)
    RunContext(CA)
    --
    -async apply(task, run_context, input_select_adjusted, contexts): Result<(), ThoError>
    -degrade(contexts): bool
  }
  interface "InputAdjustment<'a, R, C, S>" as InputAdjustment <<doc hidden>> {
    +async adjust_input(input_select_adjusted: &mut Option<S>, contexts: &mut C): Result<(), ThoError>
    +degrade_input(contexts: &mut C): bool
    {static} +async handle_success(out: R::Out, contexts: C): Result<InputAdjustedRun<C, R::Out>, ThoError>
  }
  interface "StageAdjustment<'a, R, C>" as StageAdjustment <<doc hidden>> {
    +async adjust_task(task: &mut Option<Arc<R>>, contexts: &mut C): Result<(), ThoError>
    +degrade_task(contexts: &mut C): bool
  }
  interface "RunContextAdjustment<Ctx, C>" as RunContextAdjustment <<doc hidden>> {
    +async adjust_run_ctx(run_context: &mut Option<Ctx>, contexts: &mut C): Result<(), ThoError>
    +degrade_run_ctx(contexts: &mut C): bool
  }
  interface "InputRun<R, W, S>" as InputRun {
    {static} +async run_stage(task: Arc<R>, input: Arc<W>, selector: Option<S>, tho_device_idx: usize, run_ctx: R::Ctx, retry: Option<RetryToken>): Result<R::Out, ThoError>
  }
  enum "InputAdjustedRun<C, O>" as InputAdjustedRun <<doc hidden>> {
    Done(O)
    Continue(C)
  }
  enum NoInputAdjuster <<uninhabited>>
  enum NoStageAdjuster <<uninhabited>>
  enum NoRunCtxAdjuster <<uninhabited>>
  class "Box<dyn Adjuster<IC, A = S> + 'adjuster>" as BoxInputAdjuster <<impl target>>
  class "Box<dyn Adjuster<RC, A = Arc<R>> + 'adjuster>" as BoxStageAdjuster <<impl target>>
  class "Box<dyn Adjuster<RCC, A = Ctx> + 'adjuster>" as BoxRunCtxAdjuster <<impl target>>
}

Adjuster ..> AdjusterError : adjustment result
Adjusters ..> InputAdjustment : IA bound
Adjusters ..> StageAdjustment : SA bound
Adjusters ..> RunContextAdjustment : CA bound
InputAdjustment ..> InputAdjustedRun : success result
NoInputAdjuster ..|> InputAdjustment
NoInputAdjuster ..|> InputRun
NoStageAdjuster ..|> StageAdjustment
NoRunCtxAdjuster ..|> RunContextAdjustment
BoxInputAdjuster ..|> InputAdjustment
BoxInputAdjuster ..|> InputRun
BoxStageAdjuster ..|> StageAdjustment
BoxRunCtxAdjuster ..|> RunContextAdjustment
BoxInputAdjuster ..> Adjuster : trait object (IC, S)
BoxStageAdjuster ..> Adjuster : trait object (RC, Arc<R>)
BoxRunCtxAdjuster ..> Adjuster : trait object (RCC, Ctx)

note bottom of NoInputAdjuster
  Empty enums disable their respective adjustment branches.
  NoInputAdjuster::handle_success returns Done(out).
  Its InputRun implementation uses BorrowRef without selection.
  The boxed input adjuster uses SelectRef<S> for chunk selection.
end note

package "Adjustment contexts" {
  interface "InputContext<'a, R: Stage>" as InputContext {
    +async add_partial_output(out: R::Out)
    +all_done(): bool
    +async build_final_output(): Result<R::Out, ThoError>
  }
  interface RunnableContext
  interface RunCtxContext
  interface "HasInputContext<IC>" as HasInputContext {
    +input_context(): &mut IC
    +into_input_context(): IC
  }
  interface "HasRunnableContext<RC>" as HasRunnableContext {
    +runnable_context(): &mut RC
  }
  interface "HasRunCtxContext<RCC>" as HasRunCtxContext {
    +run_ctx_context(): &mut RCC
  }
  class NoContexts
  class "WithInputContext<IC, Rest = NoContexts>" as WithInputContext {
    -input: IC
    -rest: Rest
    {static} +new(input: IC): Self
    {static} +with_rest(input: IC, rest: Rest): Self
  }
  class "WithRunnableContext<RC, Rest = NoContexts>" as WithRunnableContext {
    -runnable: RC
    -rest: Rest
    {static} +new(runnable: RC): Self
    {static} +with_rest(runnable: RC, rest: Rest): Self
  }
  class "WithRunCtxContext<RCC, Rest = NoContexts>" as WithRunCtxContext {
    -run_ctx: RCC
    -rest: Rest
    {static} +new(run_ctx: RCC): Self
    {static} +with_rest(run_ctx: RCC, rest: Rest): Self
  }
  class "Contexts<'a, R, IC, RC, RCC>" as Contexts {
    -input: IC
    -runnable: RC
    -run_ctx: RCC
    -pd: PhantomData<&'a R>
    {static} +new(input: IC, runnable: RC, run_ctx: RCC): Self
  }
  class "NoopInputContext<R: Stage + 'static>" as NoopInputContext {
    +0: Option<R::Out>
  }
  class NoopRunnableContext
  class NoopRunCtxContext
}

