note bottom of WithInputContext
  Each With*Context owns its context and Rest by value.
  Other Has*Context implementations forward to Rest when its bounds hold.
  Unlike Contexts, these wrappers do not require their own context
  to implement InputContext, RunnableContext, or RunCtxContext.
end note

package "Execution and initialization" {
  class "OOMHandler<'a, 'z, IA = NoInputAdjuster, TA = NoStageAdjuster, CA = NoRunCtxAdjuster, S = ()>" as OOMHandler {
    -adjusters: Vec<Adjusters<IA, TA, CA>>
    -statistics: Option<&'a Arc<Statistics>>
    -pd_rc: PhantomData<(&'z (), S)>
    {static} +new(adjusters, statistics): Self
    +async run<R, W, C>(task: &Arc<R>, input: Arc<W>, run_context: R::Ctx, contexts: C): Result<R::Out, ThoError>
    +async consume<R, W, C>(task: &Arc<R>, input: W, run_context: R::Ctx, contexts: C): Result<R::Out, ThoError>
    +async new_stage<I, RC, St, C, W>(sync_init: I, run_context: RC, contexts: C, ws: &Arc<RwLock<Box<W>>>): Result<Arc<St>, ThoError>
  }
  interface "SyncStageInit<RC, St, W: Workspace + ?Sized = dyn Workspace>" as SyncStageInit {
    +async init(run_context: RC, ws: Arc<RwLock<Box<W>>>): Result<Arc<St>, ThoError>
  }
  interface "RunnerRetryAdapter<'z, R: Stage, S>" as RunnerRetryAdapter <<private>> {
    +async run(task: Arc<R>, selector: Option<S>, device_idx: usize, run_ctx: R::Ctx, retry: Option<RetryToken>): Result<R::Out, ThoError>
  }
  class SyncStageInitInput <<private>>
  class "SyncStageInitOutput<St>" as SyncStageInitOutput <<private>> {
    -0: Arc<St>
  }
  class "SyncStageInitImpl<I, RC, St, W: ?Sized>" as SyncStageInitImpl <<private>> {
    -init: I
    -ws: Arc<RwLock<Box<W>>>
    -pd: PhantomData<fn(RC) -> St>
    {field} +type Ctx = RC
    {field} +type In<'a> = SyncStageInitInput
    {field} +type Out = SyncStageInitOutput<St>
  }
  class SyncStageInitRetryAdapter <<private>>
  class "SharedRunnerRetryAdapter<W, Run>" as SharedRunnerRetryAdapter <<private>> {
    -input: Arc<W>
    -runner: Run
  }
  class "ConsumeRunnerRetryAdapter<W, Run>" as ConsumeRunnerRetryAdapter <<private>> {
    -input: Option<W>
    -runner: Run
  }
  class OomFastPathKey <<private>> {
    -task: TypeId
    -input: TypeId
    -selector: TypeId
    -device_idx: usize
  }
}

