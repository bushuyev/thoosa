@startuml
title OOMHandler

skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 50

(*) --> "Run stage" as initial_run

initial_run --> if "Error?" as initial_error then
    -left->[no] (*)
else
    -->[OOM] "Get next adjuster" as get_adjuster
endif


get_adjuster --> "Apply current adjuster" as apply_adjuster

note left
The adjuster may modify:
* Input
* Stage
* RunContext
end note

apply_adjuster --> "Run stage" as run_stage


run_stage --> if "Error?" as run_error then

    -left->[no] if "Need more runs?" as more_runs then
        -up->[yes] run_stage
    else
        -left->[no] (*)
    endif

else

    -right->[OOM] if "Can current adjuster\ndegrade?" as can_degrade then

        -up->[yes] apply_adjuster

    else

        -up->[no] get_adjuster

    endif

endif

@enduml